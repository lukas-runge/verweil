-- Everything waiting for upload. Survives offline periods and app restarts.
-- Rows the server rejected keep their error and wait until the user retries them.

CREATE TABLE pending_point (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    time_ms INTEGER NOT NULL,
    lat REAL NOT NULL,
    lon REAL NOT NULL,
    accuracy REAL,
    speed REAL,
    altitude REAL,
    motion TEXT,
    error TEXT
);

insertPoint:
INSERT INTO pending_point (time_ms, lat, lon, accuracy, speed, altitude, motion)
VALUES (?, ?, ?, ?, ?, ?, ?);

oldestPoints:
SELECT * FROM pending_point WHERE error IS NULL ORDER BY time_ms, id LIMIT :limit;

deletePoints:
DELETE FROM pending_point WHERE id IN :ids;

rejectPoints:
UPDATE pending_point SET error = :error WHERE id IN :ids;

retryRejected:
UPDATE pending_point SET error = NULL WHERE error IS NOT NULL;

counts:
SELECT
    (SELECT count(*) FROM pending_point WHERE error IS NULL) AS pending,
    (SELECT count(*) FROM pending_point WHERE error IS NOT NULL) AS rejected,
    (SELECT error FROM pending_point WHERE error IS NOT NULL LIMIT 1) AS last_error;

deleteAll:
DELETE FROM pending_point;
