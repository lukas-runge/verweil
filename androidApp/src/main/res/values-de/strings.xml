    <!-- Setup -->
    <string name="setup_title">Fast fertig</string>
    <string name="setup_intro">Android muss Verweil ein paar Dinge erlauben, damit es deinen Tag verfolgen kann. Deine Standorte gehen nur an deinen Dawarich-Server.</string>
    <string name="setup_location_title">Genauer Standort</string>
    <string name="setup_location_text">Für deine Wege und die Orte, an denen du bleibst. Erforderlich.</string>
    <string name="setup_activity_title">Bewegungserkennung</string>
    <string name="setup_activity_text">Unterscheidet Sitzen von Gehen oder Fahren. Verweil bemerkt Aufbrüche früher und spart Akku.</string>
    <string name="setup_notifications_title">Mitteilungen</string>
    <string name="setup_notifications_text">Android zeigt eine an, solange Verweil aufzeichnet. Verweil meldet sich außerdem, wenn das Tracking unterbrochen wurde.</string>
    <string name="setup_background_title">Standort immer</string>
    <string name="setup_background_text">Damit Verweil auch bei geschlossener App aufzeichnet und nach einem Neustart weitermacht. Wähle in den Einstellungen „Immer zulassen“.</string>
    <string name="setup_battery_title">Keine Akku-Beschränkung</string>
    <string name="setup_battery_text">Sonst hält Android Verweil im Hintergrund an.</string>

