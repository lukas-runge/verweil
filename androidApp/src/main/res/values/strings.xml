    <string name="notice_approximate_text">With approximate location, stays and ways end up hundreds of metres off.</string>
    <string name="notice_background_title">Only while the app is open</string>
    <string name="notice_background_text">Without \"Allow all the time\", Android may stop tracking in the background, and it does not resume after a restart.</string>
