    <!-- Setup -->
    <string name="setup_title">Almost there</string>
    <string name="setup_intro">Android needs to allow a few things before Verweil can follow your day. Your locations only go to your Dawarich server.</string>
    <string name="setup_location_title">Precise location</string>
    <string name="setup_location_text">For your ways and the places you stay at. Required.</string>
    <string name="setup_activity_title">Motion detection</string>
    <string name="setup_activity_text">Tells sitting from walking or driving. Verweil notices departures sooner and saves battery.</string>
    <string name="setup_notifications_title">Notifications</string>
    <string name="setup_notifications_text">Android shows one while Verweil records. Verweil also tells you when tracking stopped.</string>
    <string name="setup_background_title">Location all the time</string>
    <string name="setup_background_text">So Verweil keeps recording with the app closed and resumes after a restart. Choose \"Allow all the time\" in the settings.</string>
    <string name="setup_battery_title">No battery restrictions</string>
    <string name="setup_battery_text">Otherwise Android pauses Verweil in the background.</string>

